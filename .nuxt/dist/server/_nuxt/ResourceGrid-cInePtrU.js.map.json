{"file":"ResourceGrid-cInePtrU.js","mappings":";;;;;;;;;;;;AA6DA,UAAM,QAAQ;AAYd,UAAM,WAAW,IAA6B,IAAI;AAClD,UAAM,aAAa,IAAI,MAAM,WAAW,SAAS,EAAE;AAEnD,UAAM,gBAAgB,SAAS,MAAM;AACnC,YAAM,UAAiD,CAAA;AACvD,UAAI,MAAM,WAAW;AACnB,gBAAQ,KAAK,EAAE,KAAK,YAAY,OAAO,UAAU,MAAM,WAAW,QAAQ,GAAA,CAAI;AAChF,UAAI,MAAM,WAAW,IAAK,SAAQ,KAAK,EAAE,KAAK,OAAO,OAAO,UAAU,MAAM,WAAW,GAAG,IAAI;AAC9F,UAAI,MAAM,WAAW;AACnB,gBAAQ,KAAK,EAAE,KAAK,cAAc,OAAO,UAAU,MAAM,WAAW,UAAU,GAAA,CAAI;AACpF,aAAO;AAAA,IACT,CAAC;AAED;AAAA,MACE,MAAM,MAAM,WAAW;AAAA,MACvB,CAAC,MAAM;AACL,mBAAW,QAAQ,KAAK;AAAA,MAC1B;AAAA,IAAA;AAqBF,aAAS,QAAQ;AACf,eAAS,OAAO,MAAA;AAAA,IAClB;AAEA,aAAa,EAAE,OAAO;;mBAlHfA,eAAAC,WAAA,EAAA,OAAM,cAAU,MAAA,CAAA,6UAaNC,MAAA,UAAA,CAAU,kBAElBC,cAAA,eAAa,QAAA,WAAW;UAMnBD,MAAA,UAAA,GAAU;;;;;;AAaT,UAAAA,MAAA,aAAA,EAAc,QAAM;;AAEVE,sBAAAF,MAAA,aAAA,IAAV,WAAM;AAMJ,gBAAA,+NAAAG,eAAA,OAAO,KAAK,CAAA,yMAAA;AAAA;;;;;;;;;;;;;;;;;;;;;;;;ACO7B,UAAM,QAAQ;AASd,UAAM,OAAO,IAAI,CAAC;AAElB;AAAA,MACE,MAAM,MAAM;AAAA,MACZ,MAAM;AAAE,aAAK,QAAQ;AAAA,MAAE;AAAA,IAAA;AAGzB,UAAM,mBAAmB,SAAS,MAAM,MAAM,UAAU,MAAM,GAAG,KAAK,QAAQ,MAAM,QAAQ,CAAC;AAC7F,UAAM,UAAU,SAAS,MAAM,iBAAiB,MAAM,SAAS,MAAM,UAAU,MAAM;;;;AAhEtE,UAAA,QAAA,UAAU,WAAM,GAAA;;;;;0HAiByBA,eAAA,QAAA,UAAU,MAAM,kBACvDA,eAAA,QAAA,UAAU,WAAM,IAAA,MAAA,EAAA;AACT,YAAA,QAAA,cAAc,QAAA,UAAU,SAAS,QAAA,YAAU;8CAAS,QAAA,UAAU,CAAA,UAAA;AAAA;;;;AAKzDD,sBAAAF,MAAA,gBAAA,IAAZ,aAAQ;;YACd,KAAK,SAAS;AAAA,YACd;AAAA,YACD,OAAM;AAAA,UAAA;;;YAKCA,MAAA,OAAA,GAAO;AAIR,gBAAA,0IAAAG,eAAA,QAAA,UAAU,SAASH,MAAA,IAAA,IAAO,QAAA,QAAQ,CAAA,oCAAA;AAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderAttr","_ssrRenderList","_ssrInterpolate"],"sources":["../../../../components/SearchBar.vue","../../../../components/ResourceGrid.vue"],"sourcesContent":["<template>\n  <div class=\"relative\">\n    <div class=\"relative flex items-center\">\n      <svg\n        class=\"absolute left-5 w-5 h-5 text-brand-500 pointer-events-none\"\n        fill=\"none\"\n        viewBox=\"0 0 24 24\"\n        stroke=\"currentColor\"\n        stroke-width=\"2.5\"\n      >\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n      </svg>\n      <input\n        ref=\"inputRef\"\n        v-model=\"localQuery\"\n        type=\"search\"\n        :placeholder=\"placeholder\"\n        class=\"input-search pl-14 pr-12 text-base\"\n        @input=\"onInput\"\n        @keydown.escape=\"clearSearch\"\n      />\n      <button\n        v-if=\"localQuery\"\n        class=\"absolute right-4 w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center\n               hover:bg-sunset-500 hover:text-white cursor-pointer transition-all duration-150\"\n        aria-label=\"Clear search\"\n        @click=\"clearSearch\"\n      >\n        <svg class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n        </svg>\n      </button>\n    </div>\n\n    <!-- Active filters -->\n    <div v-if=\"activeFilters.length\" class=\"flex flex-wrap gap-2 mt-3\">\n      <button\n        v-for=\"filter in activeFilters\"\n        :key=\"filter.key\"\n        class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-display font-semibold\n               bg-brand-600 text-white shadow-clay-sm hover:-translate-y-0.5 cursor-pointer transition-all duration-150\"\n        @click=\"removeFilter(filter.key)\"\n      >\n        <span>{{ filter.label }}</span>\n        <svg class=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"3\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n        </svg>\n      </button>\n      <button\n        class=\"text-xs text-ink-500 hover:text-brand-700 font-display font-semibold transition-colors duration-150 px-2 cursor-pointer\"\n        @click=\"clearAllFilters\"\n      >\n        Clear all\n      </button>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type { SearchFilters } from '~/types/resource'\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue: Partial<SearchFilters>\n    placeholder?: string\n  }>(),\n  { placeholder: 'Search lessons, tools, services…' }\n)\n\nconst emit = defineEmits<{\n  'update:modelValue': [value: Partial<SearchFilters>]\n}>()\n\nconst inputRef = ref<HTMLInputElement | null>(null)\nconst localQuery = ref(props.modelValue.query ?? '')\n\nconst activeFilters = computed(() => {\n  const filters: Array<{ key: string; label: string }> = []\n  if (props.modelValue.category)\n    filters.push({ key: 'category', label: `Track: ${props.modelValue.category}` })\n  if (props.modelValue.tag) filters.push({ key: 'tag', label: `Skill: ${props.modelValue.tag}` })\n  if (props.modelValue.technology)\n    filters.push({ key: 'technology', label: `Stack: ${props.modelValue.technology}` })\n  return filters\n})\n\nwatch(\n  () => props.modelValue.query,\n  (v) => {\n    localQuery.value = v ?? ''\n  }\n)\n\nfunction onInput() {\n  emit('update:modelValue', { ...props.modelValue, query: localQuery.value })\n}\n\nfunction clearSearch() {\n  localQuery.value = ''\n  emit('update:modelValue', { ...props.modelValue, query: '' })\n}\n\nfunction removeFilter(key: string) {\n  emit('update:modelValue', { ...props.modelValue, [key]: '' })\n}\n\nfunction clearAllFilters() {\n  localQuery.value = ''\n  emit('update:modelValue', { query: '', category: '', tag: '', technology: '' })\n}\n\nfunction focus() {\n  inputRef.value?.focus()\n}\n\ndefineExpose({ focus })\n</script>\n","<template>\n  <div>\n    <!-- Empty state -->\n    <div v-if=\"resources.length === 0\" class=\"flex flex-col items-center justify-center py-24 gap-4 text-center\">\n      <div class=\"w-20 h-20 rounded-[2rem] bg-white shadow-clay flex items-center justify-center text-brand-600 animate-bounce-soft\">\n        <svg class=\"w-9 h-9\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <circle cx=\"11\" cy=\"11\" r=\"7\" />\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-4.3-4.3\" />\n        </svg>\n      </div>\n      <div>\n        <p class=\"font-display font-bold text-xl text-ink-950\">No lessons found yet</p>\n        <p class=\"text-ink-500 text-sm mt-1\">Try tweaking your search or clearing a filter</p>\n      </div>\n      <slot name=\"empty-action\" />\n    </div>\n\n    <!-- Grid -->\n    <template v-else>\n      <p class=\"text-ink-500 text-sm mb-5 font-semibold\">\n        Showing <span class=\"text-ink-950 font-bold\">{{ resources.length }}</span>\n        lesson{{ resources.length !== 1 ? 's' : '' }}\n        <template v-if=\"totalCount && resources.length < totalCount\"> of {{ totalCount }}</template>\n      </p>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5\">\n        <ResourceCard\n          v-for=\"resource in visibleResources\"\n          :key=\"resource.id\"\n          :resource=\"resource\"\n          class=\"animate-fade-in\"\n        />\n      </div>\n\n      <!-- Load more -->\n      <div v-if=\"hasMore\" class=\"flex justify-center mt-10\">\n        <button class=\"btn-ghost\" @click=\"loadMore\">\n          Load more lessons\n          <span class=\"text-ink-400 text-xs font-semibold\">\n            ({{ resources.length - page * pageSize }} remaining)\n          </span>\n        </button>\n      </div>\n    </template>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type { Resource } from '~/types/resource'\n\nconst props = withDefaults(\n  defineProps<{\n    resources: Resource[]\n    totalCount?: number\n    pageSize?: number\n  }>(),\n  { pageSize: 24 }\n)\n\nconst page = ref(1)\n\nwatch(\n  () => props.resources,\n  () => { page.value = 1 }\n)\n\nconst visibleResources = computed(() => props.resources.slice(0, page.value * props.pageSize))\nconst hasMore = computed(() => visibleResources.value.length < props.resources.length)\n\nfunction loadMore() {\n  page.value++\n}\n</script>\n"],"version":3}